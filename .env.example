# Ferret Mail 开源版完整环境变量示例
# 复制为 /etc/ferret-mail.env，并使用 chmod 600 保护。
# 本文件不得填写或提交真实 Token、Cookie、SSH 密码、数据库或备份内容。

# 必填：全局管理员 Token。建议使用至少 32 字节随机值。
PANEL_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# 必填：默认主域名和服务器公网 IPv4。
MAIL_DOMAIN=example.com
PUBLIC_IP=YOUR_SERVER_IP

# 多主域名用英文逗号分隔。第一项应与 MAIL_DOMAIN 一致。
MAIL_ROOT_DOMAINS=example.com

# 启动时自动创建的额外域名或子域名，多个用英文逗号分隔。
MAIL_EXTRA_DOMAINS=

# HTTP 管理面板与 API。
HTTP_HOST=0.0.0.0
HTTP_PORT=8710

# SMTP 收件。公网邮件通常要求 TCP 25。
SMTP_HOST=0.0.0.0
SMTP_PORT=25

# 数据与备份。
DB_PATH=/var/lib/ferret-mail/inbox.sqlite3
BACKUP_DIR=/var/lib/ferret-mail/backups
MAX_BACKUP_BYTES=1073741824
MAX_BACKUPS=30
AUTO_BACKUP_HOURS=24
BACKUP_MAX_AGE_HOURS=48
MIN_DISK_FREE_BYTES=536870912
SQLITE_SYNCHRONOUS=FULL

# 邮件保存与单封大小。
RETENTION_HOURS=72
MAX_MESSAGE_BYTES=26214400
MAX_TEXT_CHARS=180000
MAX_ATTACHMENT_BYTES=10485760

# 新域名默认配额。
DEFAULT_ALIAS_LIMIT=500000
DEFAULT_MAIL_LIMIT=50000
DEFAULT_STORAGE_LIMIT_MB=1024

# HTTP 安全与限流。
API_MAX_BODY_BYTES=2097152
AUTH_FAIL_LIMIT=20
API_RATE_LIMIT_PER_MIN=240
API_MUTATION_RATE_LIMIT_PER_MIN=90
LONG_POLL_RATE_LIMIT_PER_MIN=30
LONG_POLL_MAX_ACTIVE_PER_IP=6
ALIAS_SHARE_RATE_LIMIT_PER_MIN=120
ALIAS_SHARE_TOKEN_RATE_LIMIT_PER_MIN=240

# SMTP 防滥用限制。
SMTP_CONN_RATE_LIMIT_PER_MIN=60
SMTP_MAX_RCPTS_PER_MESSAGE=25
SMTP_COMMAND_LIMIT=250
SMTP_MAX_CONNECTIONS=32
SMTP_IDLE_TIMEOUT_SECONDS=120
SMTP_DATA_TIMEOUT_SECONDS=120

# HTTP 慢连接和总并发保护。
HTTP_MAX_CONNECTIONS=128
HTTP_REQUEST_TIMEOUT_SECONDS=30

# 日志与失败邮件保留。
LOG_RETENTION_DAYS=180
FAILED_MAIL_RETENTION_DAYS=90
MAX_OPERATION_LOGS=50000

# Host 校验。加入所有实际面板域名、反向代理 Host 和服务器 IP。
# 支持 *.example.com 形式；多个值用英文逗号分隔。
TRUSTED_HOSTS=YOUR_SERVER_IP,127.0.0.1,localhost,example.com,mail.example.com,*.example.com

# 浏览器跨域白名单。仅在确实需要浏览器直连 API 时填写完整来源。
# 示例：https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# 使用 HTTPS 反向代理时填写对外访问 Origin，例如 https://mail.example.com。
# 留空时动态文档和导出链接按当前请求的 HTTP Host 生成。
PUBLIC_BASE_URL=
